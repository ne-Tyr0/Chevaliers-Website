# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# keep the template committed, never the real values
!.env.example

# local verification recordings
*.webm

# Roster and result sheets carry students' real names, grades and sections.
# The repo is public; these stay on the officer's machine. scripts/import-*.mjs
# takes the sheet path as an argument, so nothing here needs to be committed.
/scripts/*.txt
