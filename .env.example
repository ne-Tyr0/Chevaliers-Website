# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase → Project Settings → API Keys. Server-side only, never exposed to the
# browser. Not used by the app yet; kept here because the admin tasks that need
# it (bulk imports, backfills) will.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The school domain sign-ins are restricted to, without the "@".
# Set the same value in Postgres so the database enforces it too:
#   alter database postgres set app.allowed_email_domain = 'your-school.edu';
ALLOWED_EMAIL_DOMAIN=your-school.edu
