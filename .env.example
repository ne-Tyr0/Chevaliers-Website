# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase → Project Settings → API Keys. Server-side only, never exposed to the
# browser. Not used by the app yet; kept here because the admin tasks that need
# it (bulk imports, backfills) will.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The school domain sign-ins are restricted to, without the "@".
# The database enforces the same value independently; it lives in the
# club_settings table, seeded by supabase/migrations/0002_club_settings.sql.
ALLOWED_EMAIL_DOMAIN=cvisc.pshs.edu.ph
