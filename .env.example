# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase → Project Settings → API Keys.
# Bypasses row level security, so it must never reach the browser. Every officer
# write goes through it, after the passcode below has been checked.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The shared secret that unlocks the officer screens. Anyone who knows it can
# run rounds and enter results, so pick something long and change it when
# officers hand over.
OFFICER_PASSCODE=choose-a-long-passphrase

# Lets an arbiter report results and forfeits in the open round, and nothing
# else. Optional — leave blank if the club does not use arbiters. Must differ
# from OFFICER_PASSCODE.
ARBITER_PASSCODE=
